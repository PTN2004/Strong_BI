# ==============================================================================
# STRONGBI PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành '.env' và cấu hình các giá trị thực tế trước khi triển khai
# ==============================================================================

# Khóa bí mật dùng để mã hóa Session và Cookie bảo mật (Bắt buộc phải thay đổi ở Production)
# Bạn có thể tạo mã ngẫu nhiên bằng lệnh: python -c "import secrets; print(secrets.token_hex(32))"
FASTAPI_SECRET_KEY=replace_this_with_a_secure_random_hex_key

# ------------------------------------------------------------------------------
# LLM Providers (Cần cấu hình ít nhất một Key hoạt động để thực hiện Text2SQL)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-1.5-pro

OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# OAuth Configurations (Cấu hình nếu cho phép người dùng đăng nhập bằng Google/Github)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
